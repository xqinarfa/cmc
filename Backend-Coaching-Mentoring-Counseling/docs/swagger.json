{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Enterprise Backend Service for Coaching, Mentoring \u0026 Counseling (CMC) Kementerian Perhubungan RI.",
        "title": "Coaching, Mentoring \u0026 Counseling API",
        "termsOfService": "https://bpsdm.kemenhub.go.id/terms",
        "contact": {
            "name": "Tim Pengembang CMC Kemenhub",
            "url": "https://bpsdm.kemenhub.go.id",
            "email": "layanan.cmc@dephub.go.id"
        },
        "license": {
            "name": "Proprietary",
            "url": "https://bpsdm.kemenhub.go.id"
        },
        "version": "2.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/auth/google": {
            "get": {
                "description": "Redirects user to Google OAuth 2.0 authorization screen",
                "tags": [
                    "auth"
                ],
                "summary": "Google OAuth Redirect",
                "responses": {
                    "307": {
                        "description": "Redirect to Google authorization URL",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "description": "Exchange Google authorization code for a CMC JWT token pair",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Google SSO Login",
                "parameters": [
                    {
                        "description": "Google Authorization Code",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_auth_domain.SSOLoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Google Authentication successful",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Authentication failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/google/callback": {
            "get": {
                "description": "Receives Google OAuth code via GET redirect, exchanges it for token, and redirects to frontend callback",
                "tags": [
                    "auth"
                ],
                "summary": "Google OAuth Callback via Backend",
                "responses": {
                    "307": {
                        "description": "Redirect to frontend dashboard",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "description": "Authenticate user using NIP or Email and Password, returns JWT access and refresh tokens",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "User Login (NIP / Email Credentials)",
                "parameters": [
                    {
                        "description": "Login Credentials",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_auth_domain.LoginInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Invalidate and blacklist the current JWT access token in Redis",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Logout User",
                "responses": {
                    "200": {
                        "description": "Successfully logged out",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "description": "Exchange a valid refresh token for a new access token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh Access Token",
                "parameters": [
                    {
                        "description": "Refresh Token Payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_auth_domain.RefreshTokenInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Token refreshed successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Invalid or expired token",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "description": "Register a new user account with role (coach, mentor, counselor, client)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "User Registration",
                "parameters": [
                    {
                        "description": "Registration Payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_auth_domain.RegisterInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "User registered successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "409": {
                        "description": "User already exists",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/sso": {
            "get": {
                "description": "Validates EduHub token from query param. Supports pre-decoded user JSON from ?user= param.\nFormat callback aktual EduHub: /sso/auth/callback?token={JWT}\u0026user={JSON}\nJWT payload: {exp, id, image, name, nip, role, sector}\nuser JSON: {email, id, name, nip, role, image, sector}",
                "consumes": [
                    "application/json",
                    "text/html"
                ],
                "produces": [
                    "application/json",
                    "text/html"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "EduHub SSO Login",
                "parameters": [
                    {
                        "type": "string",
                        "description": "EduHub JWT token",
                        "name": "token",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Pre-decoded user JSON from EduHub callback",
                        "name": "user",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "EduHub authentication successful",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "307": {
                        "description": "Redirect to frontend dashboard callback",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "Token parameter is required",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Authentication failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "description": "Exchange SSO authorization code for CMC JWT token pair. Auto-registers ASN pegawai if not found.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "SSO Login (Kemenhub HubNet)",
                "parameters": [
                    {
                        "description": "SSO Authorization Code",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_auth_domain.SSOLoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "SSO Authentication successful",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request payload",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "SSO Authentication failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/auth/sso/url": {
            "get": {
                "description": "Returns official HubNet Kemenhub OAuth 2.0 authorization URL for client redirection",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Get SSO Kemenhub Authorization URL",
                "responses": {
                    "200": {
                        "description": "Authorization URL retrieved",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sessions": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves list of sessions for current authenticated user with optional filter \u0026 search",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "List User Sessions",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by status: pending, confirmed, completed, rejected, cancelled",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by type: coaching, mentoring, counseling",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search query by title or topic",
                        "name": "search",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sessions retrieved successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Create a new session, auto-generates pairing token (CMC-XXXX-XXXX)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Book a new Coaching / Mentoring / Counseling Session",
                "parameters": [
                    {
                        "description": "Session Booking Payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_session_domain.BookSessionInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Session booked successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Validation failed",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Retrieves session details, practitioner, client, and all meetings",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Get Session Detail by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Session UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Session details retrieved",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid ID",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "404": {
                        "description": "Session not found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/{id}/meetings": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Append an individual meeting record (Pertemuan) into a session",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Add Meeting to Session",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Session UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Meeting Payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_session_domain.AddMeetingInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Meeting added successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/{id}/meetings/{meetingId}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Removes a meeting draft from a session",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Delete Meeting Draft",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Session UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Meeting UUID",
                        "name": "meetingId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Meeting deleted successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/{id}/resend-notification": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Sends an immediate notification reminder to Coach / Mentor",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Resend Session Notification",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Session UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Reminder sent successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/sessions/{id}/status": {
            "patch": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Change session status (pending, confirmed, completed, cancelled, rejected)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sessions"
                ],
                "summary": "Update Session Status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Session UUID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Status Payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_session_domain.UpdateSessionStatusInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Status updated successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_kalanara_cmc-backend_internal_modules_auth_domain.LoginInput": {
            "type": "object",
            "required": [
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "nip": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "github_com_kalanara_cmc-backend_internal_modules_auth_domain.RefreshTokenInput": {
            "type": "object",
            "required": [
                "refresh_token"
            ],
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "github_com_kalanara_cmc-backend_internal_modules_auth_domain.RegisterInput": {
            "type": "object",
            "required": [
                "email",
                "full_name",
                "password",
                "role"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "full_name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 2
                },
                "password": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 8
                },
                "phone": {
                    "type": "string"
                },
                "role": {
                    "enum": [
                        "admin",
                        "coach",
                        "mentor",
                        "counselor",
                        "client"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_user_domain.Role"
                        }
                    ]
                }
            }
        },
        "github_com_kalanara_cmc-backend_internal_modules_auth_domain.SSOLoginRequest": {
            "type": "object",
            "required": [
                "code"
            ],
            "properties": {
                "code": {
                    "type": "string"
                },
                "redirect_uri": {
                    "type": "string"
                }
            }
        },
        "github_com_kalanara_cmc-backend_internal_modules_session_domain.AddMeetingInput": {
            "type": "object",
            "required": [
                "title"
            ],
            "properties": {
                "jp_collected": {
                    "type": "integer",
                    "maximum": 10,
                    "minimum": 1
                },
                "location": {
                    "type": "string",
                    "maxLength": 255
                },
                "meeting_type": {
                    "type": "string",
                    "enum": [
                        "Luring",
                        "Daring",
                        "Hybrid"
                    ]
                },
                "scheduled_date": {
                    "type": "string",
                    "maxLength": 100
                },
                "summary": {
                    "type": "string",
                    "maxLength": 1000
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                }
            }
        },
        "github_com_kalanara_cmc-backend_internal_modules_session_domain.BookSessionInput": {
            "type": "object",
            "required": [
                "practitioner_id",
                "title",
                "type"
            ],
            "properties": {
                "duration_minutes": {
                    "type": "integer",
                    "maximum": 240,
                    "minimum": 15
                },
                "notes": {
                    "type": "string",
                    "maxLength": 1000
                },
                "objective": {
                    "type": "string",
                    "maxLength": 1000
                },
                "practitioner_id": {
                    "type": "string"
                },
                "scheduled_at": {
                    "type": "string"
                },
                "session_format": {
                    "type": "string",
                    "enum": [
                        "1-on-1",
                        "1-on-group"
                    ]
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                },
                "topic": {
                    "type": "string",
                    "maxLength": 255
                },
                "type": {
                    "enum": [
                        "coaching",
                        "mentoring",
                        "counseling"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_session_domain.SessionType"
                        }
                    ]
                }
            }
        },
        "github_com_kalanara_cmc-backend_internal_modules_session_domain.SessionStatus": {
