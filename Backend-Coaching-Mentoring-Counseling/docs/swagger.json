                "StatusConfirmed",
                "StatusCompleted",
                "StatusCancelled",
                "StatusRejected"
            ]
        },
        "github_com_kalanara_cmc-backend_internal_modules_session_domain.SessionType": {
            "type": "string",
            "enum": [
                "coaching",
                "mentoring",
                "counseling"
            ],
            "x-enum-varnames": [
                "TypeCoaching",
                "TypeMentoring",
                "TypeCounseling"
            ]
        },
        "github_com_kalanara_cmc-backend_internal_modules_session_domain.UpdateSessionStatusInput": {
            "type": "object",
            "required": [
                "status"
            ],
            "properties": {
                "notes": {
                    "type": "string",
                    "maxLength": 1000
                },
                "status": {
                    "enum": [
                        "pending",
                        "confirmed",
                        "completed",
                        "cancelled",
                        "rejected"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/github_com_kalanara_cmc-backend_internal_modules_session_domain.SessionStatus"
                        }
                    ]
                }
            }
        },
        "github_com_kalanara_cmc-backend_internal_modules_user_domain.Role": {
            "type": "string",
            "enum": [
