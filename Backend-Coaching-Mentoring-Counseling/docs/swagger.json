                "coach",
                "mentor",
                "counselor",
                "client"
            ],
            "x-enum-varnames": [
                "RoleAdmin",
                "RoleCoach",
                "RoleMentor",
                "RoleCounselor",
                "RoleClient"
            ]
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type \"Bearer\" followed by a space and the JWT token.",
