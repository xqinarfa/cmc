# Application Configuration
APP_NAME=coaching-mentoring-counseling
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=json

# HTTP Server Configuration
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_CONTEXT_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# gRPC Server Configuration
GRPC_PORT=50051
GRPC_TIMEOUT=5s

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=cmc_user
DB_PASSWORD=cmc_password
DB_NAME=cmc_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_QUERY_TIMEOUT=5s
DB_AUTO_MIGRATE=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# NATS Event Streaming Configuration
NATS_URL=nats://localhost:4222
NATS_CLUSTER_ID=cmc-cluster
NATS_CLIENT_ID=cmc-backend
NATS_STREAM_NAME=CMC_EVENTS
NATS_PUBLISH_TIMEOUT=3s

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=cmc-assets
MINIO_LOCATION=us-east-1
MINIO_TIMEOUT=10s

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=168h
JWT_ISSUER=cmc-auth-service

# Rate Limiter
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=20
